/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

/*
 * Published outputs are defined in the output block of main.nf (workflow outputs).
 * Do not add publishDir here.
 */

process {

    /************/
    /* READS_QC */
    /************/

    // FastQC names the sample after the prefix. Different prefixes keep the
    // before and after reports of a run apart in MultiQC.
    withName: 'FASTQC_BEFORE' {
        ext.prefix = { "${meta.id}_before_qc" }
    }

    withName: 'FASTQC_AFTER' {
        ext.prefix = { "${meta.id}_after_qc" }
    }

    withName: 'FASTPLONG' {
        ext.args = [
            '--mean_qual',
            '10',
            '--length_required',
            "${params.long_reads_min_read_length}",
            '--disable_adapter_trimming'
        ].join(' ').trim()
    }

    withName: 'CHOPPER' {
        ext.args2 = [
            '--quality',
            '10',
            '--minlength',
            "${params.long_reads_min_read_length}",
            '--headcrop',
            '50',
            '--tailcrop',
            '50'
        ].join(' ').trim()
        ext.prefix = "chopped"
    }

    withName: 'PORECHOP_ABI' {
        /*
        * Porechop loads the whole fastq file in memory, so we have to request as much
        * memory as the size of the file (in GB) + a bit more for the tool to work
        * See: https://github.com/rrwick/Porechop/issues/77
        * After comparing some experimental data it looks like memory scales up exponentially
        * with the file size + a bit more
        */
        memory     = {
            ( 10.GB * task.attempt ) + 4.GB * Math.ceil(reads.size() / 1024 ** 3)
        }
        maxRetries = 3

        ext.prefix = { "${meta.id}_porechop-abi_trimmed" }
    }

    withName: 'BWAMEM2DECONTNOBAMS' {
        // BWAMEM2 is a bit wonky so we will retry regardless of the exit code
        errorStrategy = 'retry'
        maxRetries = 2

        cpus   = { 16                   }
        time   = { 8.h   * task.attempt }
        ext.prefix = "decontaminated"
    }

    withName: 'HUMAN_READS_DECONTAMINATION' {
        memory = { 64.GB + ( 64.GB * 0.5 * ( task.attempt - 1 ) ) }
    }

    withName: 'HOST_READS_DECONTAMINATION' {
        memory = {
            // This needs to be adjusted, as tthis is inteded to manage memory when the index is massive (e.g., wheat).
            def base_memory = 24.GB
            if ( ( Math.ceil( index.size() / (1024**3)) ).GB >= 5.GB ) {
                base_memory = 84.GB
            }
            return base_memory + ( base_memory * 0.5 * ( task.attempt - 1 ) )
        }
    }

    withName: 'PHIX_READS_DECONTAMINATION' {
        memory = { 32.GB + ( 32.GB * 0.5 * ( task.attempt - 1 ) ) }
    }

    withName: '.*:LONG_READS_QC:MINIMAP2_ALIGN_.*' {
        // Each line produces either an empty string, or the right "-x" preset
        // if the platform/quality conditions are met. The join at the end
        // summarises everything in a single string, omitting empty values.
        ext.args = {
            [
                (meta.platform == "ont" || meta.platform == "pb") && meta.quality == "low" ? "-x map-${meta.platform}" : '' ,
                meta.platform == "ont" && meta.quality == "high" ? "-x lr:hq" : '',
                meta.platform == "pb" && meta.quality == "high" ? "-x map-hifi" : '',
            ].findAll { arg -> arg != '' }.join(' ')
        }

        errorStrategy = 'retry'
        maxRetries = 2

        memory = { 64.GB + ( 64.GB * 0.5 * ( task.attempt - 1 ) ) }
    }

    /********************/
    /*     ASSEMBLY     */
    /********************/

    withName: 'SPADES' {
        // We increase the memory 50% with each try
        memory = {
            def assembly_memory = meta.assembly_memory ?: params.assembly_memory;
            assembly_memory.GB + ( assembly_memory.GB * 0.5 * ( task.attempt - 1 ) )
        }
        cpus   = { 32 * task.attempt }
        // TODO: tweak this based on input ( using the biome maybe? )
        time   = { 168.h * task.attempt }
        ext.args = params.spades_only_assembler ? "--only-assembler" : ""
        errorStrategy = 'retry'
        maxRetries    = params.max_spades_retries
    }

    withName: 'MEGAHIT' {
        memory = {
            def assembly_memory = meta.assembly_memory ?: params.assembly_memory;
            assembly_memory.GB + ( assembly_memory.GB * 0.5 * ( task.attempt - 1 ) )
        }
        errorStrategy = 'retry'
        maxRetries    = params.max_megahit_retries
    }

    withName: 'FLYE' {
        memory = {
            def assembly_memory = meta.assembly_memory ?: params.assembly_memory;
            assembly_memory.GB + ( assembly_memory.GB * 0.5 * ( task.attempt - 1 ) )
        }

        cpus   = { 16 * task.attempt }

        errorStrategy = 'retry'
        maxRetries    = params.max_flye_retries

        ext.args = '--meta'
    }

    /*****************************************/
    /*   POST-ASSEMBLY DECONT - SHORT READS  */
    /*****************************************/

    // The 'MIASSEMBLER:' anchor keeps these selectors out of the tests of the shared
    // decontamination modules and subworkflows, which run with this config too.

    // contig alignment for decontamination
    withName: 'MIASSEMBLER:.*_DECONTAMINATE_CONTIGS:MINIMAP2_ALIGN' {
        ext.args = "-k 13 -w 5"

        errorStrategy = 'retry'
        maxRetries = 2

        memory = { 64.GB + ( 64.GB * 0.5 * ( task.attempt - 1 ) ) }
    }

    withName: 'MIASSEMBLER:.*:PHIX_DECONTAMINATE_CONTIGS:MINIMAP2_ALIGN' {
        memory = { 24.GB + ( 24.GB * 0.5 * ( task.attempt - 1 ) ) }
    }

    // The prefix keeps the tables of the three steps apart in the same output folder.
    // MultiQC custom-content headers, from subworkflows/ebi-metagenomics/decontaminate_assemblies/nextflow.config
    withName: 'MIASSEMBLER:.*:HUMAN_DECONTAMINATE_CONTIGS:FILTERPAF' {
        ext.prefix      = { "${meta.id}_human" }
        ext.mqc_id      = 'human_decontamination'
        ext.mqc_section = { "Human contaminated contigs (${meta.human_reference})" }
        ext.mqc_title   = { "Human Contamination Removal (${meta.human_reference})" }
    }

    withName: 'MIASSEMBLER:.*:PHIX_DECONTAMINATE_CONTIGS:FILTERPAF' {
        ext.prefix      = { "${meta.id}_phix" }
        ext.mqc_id      = 'phix_decontamination'
        ext.mqc_section = { "PhiX contaminated contigs (${meta.phix_reference})" }
        ext.mqc_title   = { "PhiX Contamination Removal (${meta.phix_reference})" }
    }

    withName: 'MIASSEMBLER:.*:HOST_DECONTAMINATE_CONTIGS:FILTERPAF' {
        ext.prefix      = { "${meta.id}_contaminant" }
        ext.mqc_id      = 'host_decontamination'
        ext.mqc_section = { "Host/Contaminant contaminated contigs (${meta.contaminant_reference})" }
        ext.mqc_title   = { "Host/Contaminant Removal (${meta.contaminant_reference})" }
    }

    withName: 'MIASSEMBLER:.*:SEQKIT_GREP' {
        ext.args = "--invert-match"
        // defining the prefix is necessary to avoid "same filename error"
        ext.prefix = { "${meta.id}_cleaned" }
    }

    /****************************************/
    /* POST-ASSEMBLY POLISHING - LONG READS */
    /****************************************/

    withName: '.*_LQ:MINIMAP2_ALIGN' {
        ext.args = { meta.platform.matches("ont|pb") ? "-x map-${meta.platform}" : '' }

        errorStrategy = 'retry'
        maxRetries = 2

        memory = { 64.GB + ( 64.GB * 0.5 * ( task.attempt - 1 ) ) }
    }

    withName: 'RACON' {
        ext.args = [
            '--match',             // Score for matching bases
            '8',
            '--mismatch',          // Score for mismatching bases
            '-6',
            '--gap',               // gap penalty (must be negative)
            '-8',
            '--window-length',     // size of window on which POA is performed
            '500',
            '--quality-threshold', // threshold for average base quality of windows used in POA
            '-1'
        ].join(' ').trim()
    }

    withName: 'MEDAKA' {
        ext.args = "-m r941_min_sup_g507"       // model (optimised for generic execution)
        time = { 16.h * task.attempt }
        maxRetries = 3
    }

    withName: 'PROOVFRAME_MAP' {
        time   = { 24.h * task.attempt }
        memory = { 100.GB * 0.5 * (task.attempt + 1) }
        maxRetries = 2
        cpus   = 32
        ext.args = " --diamond-mode mid-sensitive "
    }

    withName: 'HIFIADAPTERFILT' {
        cpus   = { 1    * task.attempt }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    /************/
    /* COVERAGE */
    /************/

    withName: 'LONG_READS_COVERAGE' {
        errorStrategy = 'retry'
        maxRetries = 2

        memory = { 64.GB + ( 64.GB * 0.5 * ( task.attempt - 1 ) ) }

        ext.jgi_summarize_bam_contig_depths_args = ''
    }

    withName: 'SHORT_READS_COVERAGE' {
        ext.jgi_summarize_bam_contig_depths_args = ''

        ext.alignment_args = [
            "-q", "20",
            "-Sb",
            "-F", "4"
        ].join(' ')
    }

    withName: 'CALCULATE_ASSEMBLY_COVERAGE' {
        errorStrategy = 'retry'
        maxRetries = 2
        cpus   = { 1      * task.attempt }
        memory = { 10.GB * task.attempt }
        time   = { 1.h   * task.attempt }
    }

    /***************/
    /* FINAL STEPS */
    /***************/

    withName: 'MULTIQC_STUDY' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }

    withName: 'MULTIQC_RUN' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }

    withName: 'QUAST' {
        // Disable Quast reference download
        // NOTICE: Maximum number of references (--max-ref-number) is set to 0, search in SILVA 16S rRNA database is disabled //
        ext.args = "--max-ref-num 0"
    }
}
