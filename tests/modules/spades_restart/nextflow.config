/*
 * Forces SPADES to fail twice, after it has written checkpoints, so the
 * retries must restart from the checkpoints of the first attempt
 * (see the restart logic in modules/nf-core/spades/main.nf).
 */
process {
    withName: 'SPADES' {
        cpus          = 2
        memory        = { 2.GB * task.attempt }
        time          = 1.h
        errorStrategy = 'retry'
        maxRetries    = 2
        publishDir    = []

        // Attempt 1 stops right after the K21 checkpoint. Attempt 2+ use --restart-from,
        // which ignores ext.args (SPAdes keeps the options of the original run)
        ext.args      = { task.attempt == 1 ? "--meta --only-assembler --stop-after k21" : "--meta --only-assembler" }

        // Attempts 1 and 2 fail on purpose after SPAdes has finished ('mv' into a missing folder)
        ext.prefix    = { task.attempt < 3 ? "missing_folder/${meta.id}" : "${meta.id}" }
    }
}
