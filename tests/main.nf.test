nextflow_pipeline {

    name "Test Workflow EBIMETAGENOMICS_MIASSEMBLER"
    script "main.nf"

    test("Samplesheet spades") {

        tag "samplesheet"
        tag "SR"

        when {
            params {
                assembler   = "spades"
                samplesheet = "${projectDir}/tests/samplesheet/test.csv"
            }
        }

        then {
            with(workflow) {
                assert success
                assert trace.succeeded().count{ task -> task.name.contains("SPADES") } == 2
                assert trace.succeeded().count{ task -> task.name.contains("MEGAHIT") } == 1
            }
        }

    }

    test("Samplesheet - no assembled - reads filtered") {

        tag "samplesheet"
        tag "SR"

        when {
            params {
                assembler                             = "spades"
                short_reads_low_reads_count_threshold = 1000000
                samplesheet                           = "${projectDir}/tests/samplesheet/test.csv"
            }
        }

        then {
            with(workflow) {
                assert success
                assert trace.succeeded().count{ task -> task.name.contains("FASTQC_BEFORE") } == 3
                assert trace.succeeded().count{ task -> task.name.contains("FASTP") } == 3
                assert trace.succeeded().count{ task -> task.name.contains("PHIX_READS_DECONTAMINATION") } == 3
                assert trace.succeeded().count{ task -> task.name.contains("FASTQC_AFTER") } == 3
                assert trace.succeeded().count{ task -> task.name.contains("CUSTOM_DUMPSOFTWAREVERSIONS") } == 1
                assert trace.succeeded().count{ task -> task.name.contains("MULTIQC_STUDY") } == 2
                assert trace.succeeded().count{ task -> task.name.contains("SPADES") } == 0
                assert trace.succeeded().count{ task -> task.name.contains("MEGAHIT") } == 0
                // This process should not have been called
                assert trace.succeeded().count{ task -> task.name.contains("DOWNLOAD_FROM_FIRE") } == 0
            }
        }

    }

    test("Samplesheet metaSPAdes - paired end") {

        tag "slow"
        tag "SR"

        when {
            params {
                // Force the assembly
                short_reads_filter_ratio_threshold = 0.1
                short_reads_contig_threshold       = 1
                samplesheet                         = "${projectDir}/tests/samplesheet/test_srr6180434.csv"
            }
        }

        then {
            with (workflow) {
                assert success
                assert trace.succeeded().count{ task -> task.name.contains("SPADES") } == 1
                assert trace.succeeded().count{ task -> task.name.contains("MEGAHIT") } == 0
            }
        }
    }

    test("Samplesheet MEGAHIT - paired end") {

        tag "slow"
        tag "SR"

        when {
            params {
                assembler                          = "megahit"
                short_reads_filter_ratio_threshold = 0.1
                samplesheet                        = "${projectDir}/tests/samplesheet/test_srr6180434.csv"
            }
        }

        then {
            with(workflow) {
                assert success
                assert trace.succeeded().count{ task -> task.name.contains("SPADES") } == 0
                assert trace.succeeded().count{ task -> task.name.contains("MEGAHIT") } == 1
            }
        }
    }

    test("Samplesheet metaSPAdes - too few contigs") {

        tag "samplesheet"
        tag "SR"

        when {
            params {
                short_reads_filter_ratio_threshold = 0.1
                samplesheet                        = "${projectDir}/tests/samplesheet/test_srr6180434.csv"
            }
        }

        then {
            with (workflow) {
                // Cleaned assembly should contain too few contigs and the pipeline should stop after QC.
                assert success
                assert trace.succeeded().count{ task -> task.name.contains("SPADES") } == 1
                assert trace.succeeded().count{ task -> task.name.contains("MEGAHIT") } == 0
            }
        }
    }

    test("Samplesheet metaSPAdes - SRR1211894 single end should fail") {

        tag "samplesheet"
        tag "SR"

        when {
            params {
                assembler   = "metaspades"
                samplesheet = "${projectDir}/tests/samplesheet/test_srr1211894.csv"
            }
        }

        then {
            with(workflow) {
                assert !success
                assert trace.failed().count{ task -> task.name.contains("SPADES") } == 1
            }
        }
    }

    test("Samplesheet MEGAHIT - SRR1211894 single end should produce an empty contigs file") {

        tag "slow"
        tag "SR"

        when {
            params {
                samplesheet = "${projectDir}/tests/samplesheet/test_srr1211894.csv"
            }
        }

        then {
            with(workflow) {
                assert success
                assert trace.succeeded().count{ task -> task.name.contains("MEGAHIT") } == 1
            }
        }
    }

    test("Samplesheet MEGAHIT - metaT - single end") {

        tag "samplesheet"
        tag "SR"

        when {
            params {
                samplesheet = "${projectDir}/tests/samplesheet/test_drr280712.csv"
            }
        }

        then {
            with(workflow) {
                assert success
                assert trace.succeeded().count{ task -> task.name.contains("SPADES") } == 0
                assert trace.succeeded().count{ task -> task.name.contains("MEGAHIT") } == 1
            }
        }
    }

    test("Samplesheet Spades - metaT - single end should fail") {

        tag "slow"
        tag "SR"

        when {
            params {
                assembler   = "spades"
                samplesheet = "${projectDir}/tests/samplesheet/test_drr280712.csv"
            }
        }

        then {
            with(workflow) {
                assert !success
                assert trace.failed().count{ task -> task.name.contains("SPADES") } == 1
            }
        }
    }

    test("Samplesheet spades - retries") {

        tag "slow"
        tag "retries"
        tag "SR"

        when {
            params {
                assembler         = "spades"
                samplesheet       = "${projectDir}/tests/samplesheet/test_mem.csv"
                assembly_memory   = 0.5
                /* Memory jumping testing */
                /* will try with [0.5GB, 0.75GB, 1.13GB, ...]
                /* which rounds down to [0, 0, 1, ...]
                /* so should definitely fail twice before succeeding. after a few trys.
                /* ~~~ */
                max_spades_retries = 5
            }
        }

        then {
            with(workflow) {
                // eventual success:
                assert success
                assert trace.succeeded().count{ task -> task.name.contains("SPADES") } == 1

                // but failed and therefore retried multiple times first:
                assert trace.failed().count{ task -> task.name.contains("SPADES") } >= 2
            }
        }

    }

    test("Samplesheet FIRE download - missing secrets should fail") {

        tag "samplesheet"
        tag "fire"
        tag "SR"

        when {
            params {
                assembler         = "spades"
                samplesheet       = "${projectDir}/tests/samplesheet/test_fire.csv"
                use_fire_download = true
            }
        }

        then {
            with(workflow) {
                assert !success
                assert stdout.count{ line -> line.contains("Required secrets are missing") } == 1
            }
        }
    }

    test("Samplesheet LR ONT HQ") {

        tag "slow"
        tag "LR"

        when {
            params {
                samplesheet     = "${projectDir}/tests/samplesheet/test_long_reads_ont_hq.csv"
                phix_reference  = null
            }
        }

        then {
            with(workflow) {
                assert success

                assert trace.succeeded().count{ task -> task.name.contains("MEDAKA") } == 0
                assert trace.succeeded().count{ task -> task.name.contains("ONT_HQ") } == 1
            }
        }
    }

    test("Samplesheet LR ONT LQ") {

        tag "slow"
        tag "LR"

        when {
            params {
                samplesheet     = "${projectDir}/tests/samplesheet/test_long_reads_ont_lq.csv"
                phix_reference  = null
            }
        }

        then {
            with(workflow) {
                assert success

                assert trace.succeeded().count{ task -> task.name.contains("ONT_LQ") } == 4
            }
        }
    }

    test("Samplesheet LR PB HIFI") {

        tag "samplesheet"
        tag "LR"

        when {
            params {
                samplesheet     = "${projectDir}/tests/samplesheet/test_long_reads_pb_hifi.csv"
                phix_reference  = null
            }
        }

        then {
            with(workflow) {
                assert success

                assert trace.succeeded().count{ task -> task.name.contains("PACBIO_HIFI") } == 2
            }
        }
    }

    test("Samplesheet LR PB LQ") {

        tag "slow"
        tag "LR"

        when {
            params {
                samplesheet     = "${projectDir}/tests/samplesheet/test_long_reads_pb_lq.csv"
                phix_reference  = null
            }
        }

        then {
            with(workflow) {
                assert success

                assert trace.succeeded().count{ task -> task.name.contains("PACBIO_LQ") } == 4
            }
        }
    }

    test("Skip human decontamination - warning displayed and processes skipped") {

        tag "samplesheet"
        tag "skip_human_decontamination"
        tag "SR"

        when {
            params {
                assembler                   = "spades"
                samplesheet                 = "${projectDir}/tests/samplesheet/test.csv"
                skip_human_decontamination  = true

                human_reference             = null
                phix_reference              = "phix"
            }
        }

        then {
            with(workflow) {
                assert success

                // Verify human decontamination processes are not executed
                assert trace.succeeded().count{ task -> task.name.contains("MINIMAP2_ALIGN_HUMAN") } == 0
                assert trace.succeeded().count{ task -> task.name.contains("HUMAN_DECONTAMINATE_CONTIGS") } == 0
                assert trace.succeeded().count{ task -> task.name.contains("SPADES") } == 2
                assert trace.succeeded().count{ task -> task.name.contains("PHIX_READS_DECONTAMINATION") } == 3
                assert trace.succeeded().count{ task -> task.name.contains("FASTQC_BEFORE") } == 3
                assert trace.succeeded().count{ task -> task.name.contains("MULTIQC_STUDY") } == 2
            }
        }
    }

    test("Skip human decontamination - throw an error if the human_reference is provided and skip human decont is true") {

        tag "samplesheet"
        tag "skip_human_decontamination"
        tag "SR"

        when {
            params {
                assembler                   = "spades"
                samplesheet                 = "${projectDir}/tests/samplesheet/test.csv"
                // It's incompatible to try to skip the decontamination of human data while setting the human_reference. We strongly discourage skipping this step.
                skip_human_decontamination  = true
                human_reference             = "human"
            }
        }

        then {
            with(workflow) {
                assert !success
            }
        }
    }
}
